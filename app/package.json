{
  "name": "althio-practice",
  "private": true,
  "version": "0.1.0",
  "description": "Althio practice workspace: client records, CSV import, and role-aware roster",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
